{
  "name": "@wa-leg/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "wa-leg": "./bin/wa-leg.mjs"
  },
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "start": "tsx src/index.ts",
