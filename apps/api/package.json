    "@opensearch-project/opensearch": "3.6.0",
    "@wa-leg/bill-document": "workspace:*",
    "@wa-leg/billref": "workspace:*",
    "@wa-leg/note-schema": "workspace:*",
    "@wa-leg/workflow-machine": "workspace:*",
    "commander": "15.0.0",
    "drizzle-orm": "0.45.2",
    "fastify": "5.12.1",
    "fastify-plugin": "6.0.0",
    "fastify-type-provider-zod": "7.0.0",
    "jose": "6.2.10",
    "openid-client": "6.8.7",
    "pg": "8.23.0",
    "pino": "10.3.1",
    "pino-pretty": "13.1.3",
    "tsx": "4.23.13",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/nodemailer": "8.0.1",
    "@types/node": "22.20.1",
    "@types/pg": "8.23.1",
    "@wa-leg/dev-oidc": "workspace:*",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
