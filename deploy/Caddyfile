# One hostname. Caddy obtains and renews the certificate for $SITE_ADDRESS.
#   /api/*   Fastify API (apps/api)
#   /oidc/*  development OpenID Connect issuer (apps/dev-oidc); the prefix is stripped
#   /*       the web bundle, with the SPA fallback to index.html
{
	email {$ACME_EMAIL}
}

{$SITE_ADDRESS} {
	encode gzip zstd

	handle /api/* {
		reverse_proxy api:4800
	}

	handle_path /oidc/* {
		reverse_proxy oidc:4801
	}

	handle {
		root * /srv
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		try_files {path} /index.html
		file_server
	}
}
