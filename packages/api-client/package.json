{
  "name": "@wa-leg/api-client",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "generate": "pnpm --filter @wa-leg/api run cli openapi --out openapi.json && openapi-typescript openapi.json -o src/schema.d.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "openapi-fetch": "0.17.0"
  },
  "devDependencies": {
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
