# Copy to .env for local development. docker compose exposes these ports.
DATABASE_URL=postgres://wa_leg:wa_leg@localhost:5433/wa_leg
API_PORT=4800
WEB_ORIGIN=http://localhost:5173
SESSION_SECRET=dev-session-secret-change-me
OIDC_ISSUER=http://localhost:4801
OIDC_CLIENT_ID=wa-leg-web
OIDC_CLIENT_SECRET=dev-client-secret
OIDC_REDIRECT_URI=http://localhost:4800/api/v1/auth/callback
SEARCH_BACKEND=opensearch
OPENSEARCH_URL=http://localhost:9201
LAWFILES_CACHE_DIR=.cache/lawfiles
